{
  "appId": "com.ketotrack.garmin",
  "appName": "KetoTrack",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "*.garmin.com",
      "sso.garmin.com",
      "connect.garmin.com"
    ]
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorCookies": {
      "enabled": true
    },
    "Health": {
      "permissions": [
        "steps",
        "calories",
        "heartRate"
      ]
    }
  }
}
