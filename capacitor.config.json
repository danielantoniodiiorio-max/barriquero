{
  "appId": "com.ketotrack.garmin",
  "appName": "Barriketo",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorCookies": {
      "enabled": true
    },
    "Health": {
      "permissions": [
        "steps",
        "calories",
        "heartRate"
      ]
    }
  }
}
